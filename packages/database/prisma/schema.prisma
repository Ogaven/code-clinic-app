generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS — PostgreSQL native enum types
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  ACCOUNTS
  DEVELOPER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  ARRIVED
  WAITING
  IN_OPERATORY
  WITH_PROVIDER
  SESSION_COMPLETE
  CHECKOUT
  DEPARTED
  COMPLETED
  CANCELLED
  CANCELLED_RESCHEDULED
  RESCHEDULED
  NO_SHOW
  CHECKED_IN
  IN_CHAIR
  READY_CHECKOUT
  IMPORTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  UNPAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  HUMAN_TAKEOVER
  CLOSED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EligibilityStatus {
  ACTIVE
  TERMINATED
  ON_LEAVE
}

enum BalancePayer {
  EMPLOYEE
  EMPLOYER
  SPLIT
}

enum PatientStatus {
  NEW_LEAD
  UPCOMING
  ACTIVE
  DUE_RECALL
  LAPSED
  DORMANT
  BALANCE_OWING
}

// ─────────────────────────────────────────────
// CRM AUTOMATION — Patient Tag Taxonomy enums
// Additive only. Distinct names/fields chosen to avoid colliding with
// existing free-text Patient.referredBy / Patient.referralSource (legacy
// referral-program fields, left untouched) and existing PatientStatus.
// ─────────────────────────────────────────────

enum TreatmentType {
  CLEANING
  FILLING
  CROWN
  ROOT_CANAL
  EXTRACTION
  ORTHO
  IMPLANT
  WHITENING
  DENTURE
}

enum TreatmentPlanStatus {
  NONE
  PROPOSED
  INCOMPLETE
  ACCEPTED
  DECLINED
}

enum RecallInterval {
  THREE_MONTH
  SIX_MONTH
  TWELVE_MONTH
}

enum PatientLifecycleStage {
  NEW
  ESTABLISHED
}

enum RecallStatus {
  NOT_DUE
  DUE
  OVERDUE_30
  OVERDUE_90
  OVERDUE_180_PLUS
}

enum DeclineReason {
  COST
  TIMING
  SECOND_OPINION
  UNKNOWN
  OTHER
}

enum PatientPaymentType {
  INSURANCE
  SELF_PAY
  FINANCING_ACTIVE
}

enum BalanceStatus {
  CURRENT
  OWING
}

enum ValueTier {
  STANDARD
  HIGH_VALUE
}

enum RiskFlag {
  PERIO_RISK
  HIGH_CARIES_RISK
  EMERGENCY_HISTORY
}

enum ReferralSourceType {
  GOOGLE
  INSURANCE_DIRECTORY
  PATIENT_REFERRAL
  OTHER
}

enum CommsChannel {
  SMS
  WHATSAPP
  EMAIL
}

// ─────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              UserRole  @default(RECEPTIONIST)
  firstName         String
  lastName          String
  phone             String?
  avatarR2Key       String?
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  isActive          Boolean   @default(true)
  permissions       String?   @default("{}")
  lastLogin         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  doctor            Doctor?
  auditLogs         AuditLog[]
  assistantMessages AssistantMessage[]
  supportTickets    SupportTicket[]
  expenses          Expense[]      @relation("RecordedBy")
  payroll           StaffPayroll[]
  appointments      Appointment[]  @relation("CreatedBy")
  staffConfirmedAppointments Appointment[] @relation("StaffConfirmedBy")
  treatmentNotes    TreatmentNote[]
  staffAttendances  StaffAttendance[]
  messageTemplates  MessageTemplate[]
  pushSubscriptions PushSubscription[]

  knowledgeStudioConversations KnowledgeStudioConversation[]
  aiKnowledgeIngestions        AiKnowledgeIngestion[]

  // ── CRM Automation (additive) ──
  assignedTasks     Task[]            @relation("TaskAssignee")
  collectionsCases  CollectionsCase[] @relation("CollectionsCaseOwner")

  @@index([isActive])
  @@map("users")
}

model Doctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation String?
  colour         String   @default("#4A90D9")
  photoR2Key     String?
  workingDays    String   @default("[1,2,3,4,5]")
  workingHours   String   @default("{\"start\":\"08:00\",\"end\":\"18:00\"}")
  serviceIds     String   @default("[]")
  bookingMode    String   @default("OPEN")  // "OPEN" or "BY_REFERRAL"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments   Appointment[]
  blockedTimes   BlockedTime[]
  schedules      DoctorSchedule[]
  treatmentPlans TreatmentPlan[]

  // ── CRM Automation (additive) — Patient.providerId assignment ──
  crmAssignedPatients Patient[] @relation("PatientAssignedProvider")
  waitlistEntries     WaitlistEntry[]

  @@map("doctors")
}

model BlockedTime {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@map("blocked_times")
}

model WorkingHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0=Sun, 1=Mon ... 6=Sat
  isOpen    Boolean  @default(true)
  openTime  String
  closeTime String
  breaks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
  @@map("working_hours")
}

model DoctorSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  isOpen    Boolean  @default(true)
  openTime  String?
  closeTime String?
  breaks    Json?
  slots     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model SpecialDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  type      String   // "DAY_OFF" | "SPECIAL_WORKING"
  openTime  String?
  closeTime String?
  note      String?
  createdAt DateTime @default(now())

  @@map("special_days")
}

model Patient {
  id                    String   @id @default(uuid())
  patientNumber         Int      @default(autoincrement())
  firstName             String
  lastName              String
  phone                 String
  email                 String?
  dob                   DateTime?
  gender                Gender?
  address               String?
  district              String?
  medicalNotesEncrypted String?
  avatarR2Key           String?
  accountBalance        Int      @default(0)
  isActive              Boolean  @default(true)
  referredBy            String?
  referralSource        String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelation     String?
  allergies             String?
  medicalHistory        String?
  status                PatientStatus @default(NEW_LEAD)
  importSource          String?       // "SHEET" | "CSV" — set on bulk import, null for manual registrations
  patientType           String?       // "NEW" | "EXISTING" — manually set by staff at registration
  guardianId            String?
  isMinor               Boolean  @default(false)
  relationship          String?       // "child" | "spouse" | "dependent" | "other"
  familyAccountId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // ── CRM Automation — Patient Tag Taxonomy (Part A, additive) ──
  // Clinical / treatment
  treatmentTypes        TreatmentType[]       @default([])
  treatmentPlanStatus   TreatmentPlanStatus   @default(NONE)
  recallInterval        RecallInterval?
  providerId            String?
  provider              Doctor?               @relation("PatientAssignedProvider", fields: [providerId], references: [id])
  // Lifecycle / behavioral
  lifecycleStage        PatientLifecycleStage @default(NEW)
  recallStatus          RecallStatus          @default(NOT_DUE)
  noShowCount           Int                   @default(0)
  lateCancelCount       Int                   @default(0)
  declineReason         DeclineReason?
  declineReasonNote     String?               // free-text extension, only meaningful when declineReason = OTHER
  // Financial — outstanding amount reuses existing accountBalance (no redundant field)
  paymentType           PatientPaymentType?
  balanceStatus         BalanceStatus         @default(CURRENT)
  balanceAgingBucket    String?               // "CURRENT" | "30" | "60" | "90" | "90_PLUS" — derived
  valueTier             ValueTier             @default(STANDARD)
  // Risk / urgency
  riskFlags             RiskFlag[]            @default([])
  // Source / preference — distinct fields from legacy referredBy/referralSource above
  // (those back an existing, unrelated patient-referral-program feature and are left untouched)
  crmReferralSource     ReferralSourceType?
  crmReferredByPatientId String?
  crmReferredByPatient  Patient?              @relation("CrmReferredBy", fields: [crmReferredByPatientId], references: [id])
  crmReferrals          Patient[]             @relation("CrmReferredBy")
  commsChannelPref      CommsChannel?
  languagePref          String?
  // Cross-cutting automation flags
  waitlistAvailable     Boolean               @default(false)
  negativeExperience    Boolean               @default(false)
  tagsUpdatedAt         DateTime?
  tagsUpdatedBy         String?               // User.id; null = system/automated update

  guardian              Patient?  @relation("GuardianDependents", fields: [guardianId], references: [id])
  dependents            Patient[] @relation("GuardianDependents")
  familyAccount         FamilyAccount? @relation(fields: [familyAccountId], references: [id])

  appointments          Appointment[]
  invoices              Invoice[]
  payments              Payment[]
  feedback              PatientFeedback[]
  nurtureLogs           NurtureLog[]
  agentLogs             AgentLog[]
  agentMemory           AgentMemory[]
  outboundQueue         OutboundQueue[]
  treatmentPlans        TreatmentPlan[]
  treatmentNotes        TreatmentNote[]
  dentalChart           DentalChart?
  documents             PatientDocument[]
  activities            PatientActivity[]
  aiConversations       AiConversation[]
  aiScheduledMessages   AiScheduledMessage[]
  patientSponsors       PatientSponsor[]
  patientConsents       PatientConsent[]
  botMessageLogs        BotMessageLog[]

  // ── CRM Automation relations (additive) ──
  sequenceEnrollments   SequenceEnrollment[]
  scheduledTouches      ScheduledTouch[]
  consentLogs           ConsentLog[]
  callEvents            CallEvent[]
  collectionsCase       CollectionsCase?
  waitlistNotifications WaitlistNotification[]
  reviewRequestLogs     ReviewRequestLog[]
  waitlistEntries       WaitlistEntry[]

  @@index([isActive, createdAt])
  @@index([lastName, firstName])
  @@index([status])
  @@index([guardianId])
  @@index([familyAccountId])
  // CRM automation lookups (Part S)
  @@index([recallStatus])
  @@index([treatmentPlanStatus])
  @@index([balanceStatus])
  @@index([providerId])
  @@map("patients")
}

model Service {
  id             String  @id @default(uuid())
  name           String
  description    String?
  category       String  @default("General")
  durationMins   Int     @default(30)
  priceUGX       Int
  priceUSD       Float?
  vatApplicable  Boolean @default(true)
  colour         String  @default("#29ABE2")
  photoR2Key     String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments   Appointment[]
  feeSchedules   FeeSchedule[]
  waitlistEntries WaitlistEntry[]

  @@unique([name])
  @@map("services")
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  startAt     DateTime
  endAt       DateTime
  status      AppointmentStatus @default(PENDING)
  notes         String?
  googleEventId String?
  createdById   String?
  createdBy     User?    @relation("CreatedBy", fields: [createdById], references: [id])
  arrivedAt     DateTime?
  withProviderAt DateTime?
  departedAt    DateTime?
  followUpSent   Boolean   @default(false)
  followUpSentAt DateTime?
  // Staff personally called and verbally confirmed this appointment with the
  // patient — when set, Sarah's own same-day reminder must not also send for
  // this appointment (staff and the bot messaging the same patient
  // independently, with neither aware of the other, was a real complaint).
  staffConfirmedAt   DateTime?
  staffConfirmedById String?
  staffConfirmedBy   User?     @relation("StaffConfirmedBy", fields: [staffConfirmedById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice     Invoice?
  feedback    PatientFeedback?

  @@index([doctorId, startAt])
  @@index([patientId, startAt])
  @@index([followUpSent, status])
  @@index([status, startAt])
  @@map("appointments")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  lineItems     String   // JSON string
  subtotalUGX   Int
  vatUGX        Int      @default(0)
  totalUGX      Int
  paidUGX       Int           @default(0)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  notes         String?
  // QuickBooks sync
  qbInvoiceId   String?
  qbCustomerId  String?
  qbSyncStatus  String?   // PENDING | SYNCED | FAILED
  qbSyncedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      Payment[]

  @@index([patientId, status])
  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  amountUGX   Int
  method      String   // CASH | MTN_MOMO | AIRTEL_MONEY | VISA | MASTERCARD | etc
  reference   String?
  paidAt      DateTime @default(now())
  notes       String?
  qbPaymentId String?  // QuickBooks payment ID
  createdAt   DateTime @default(now())

  @@map("payments")
}

model Expense {
  id           String   @id @default(uuid())
  category     String
  amountUGX    Int
  description  String
  receiptR2Key String?
  recordedById String?
  recordedBy   User?    @relation("RecordedBy", fields: [recordedById], references: [id])
  date         DateTime @default(now())
  qbPurchaseId String?  // QuickBooks purchase ID
  createdAt    DateTime @default(now())

  @@map("expenses")
}

model StaffPayroll {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  month           String
  grossUGX        Int
  nssfEmployee    Int
  nssfEmployer    Int
  paye            Int
  otherDeductions Int      @default(0)
  netUGX          Int
  status          String   @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  @@unique([userId, month])
  @@map("staff_payroll")
}

model Lead {
  id          String   @id @default(cuid())
  name        String?
  phone       String?
  email       String?
  source      String   // WHATSAPP, FACEBOOK, WEBSITE, INSTAGRAM, WALKIN, OTHER
  stage       String   @default("NEW")   // kept for quiz/nurture compat
  status      String   @default("NEW")   // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  score       Int      @default(0)
  assignedTo  String?
  quizId      String?
  quizAnswers String?  // JSON string
  notes       String?
  lastMessage String?
  convertedToPatientId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Lead Pipeline Automation (Part J-Q, additive) ──
  firstReplyAt      DateTime?  // first STAFF outbound reply to this lead (response-time SLA metric — see reporting.service.ts)
  firstHumanReplyAt DateTime?  // first reply explicitly logged as human-by-the-assigned-owner — drives NEW->CONTACTED (Part N)
  lastInboundReplyAt DateTime? // most recent message FROM the lead (inbound only — never written by logHumanReply) — drives the "responds again within 48h" half of CONTACTED->QUALIFIED (Part N)
  lastOutboundAt     DateTime? // most recent STAFF outbound message to the lead — drives "no response within 48h of last outbound" for CONTACTED->LOST (Part N)
  slaState          String?    @default("PENDING") // PENDING | REPLIED | ESCALATED_15 | ESCALATED_30 | STALE_24H | CANCELLED
  qualifyingIntent  String?    // set when owner marks a qualifying intent signal (pricing/appointment/etc.) — Part N
  lossReason        String?    // required whenever status is set to LOST (automated "no_response" or manual override reason)
  backlogTag        Boolean    @default(false)  // Part Q one-time backlog re-engagement
  backlogNoResponse Boolean    @default(false)
  backlogCampaignAt DateTime?

  // ── Acquisition attribution (additive, immutable first-touch) ──
  // Written ONLY at lead-creation time by the intake path (lead-intake.
  // service.ts / attribution.service.ts) — never touched by PATCH
  // /crm/leads/:id or any later update path, so first-touch attribution can
  // never be silently overwritten by a later edit. `source` (above) stays
  // the existing coarse channel bucket (WHATSAPP/FACEBOOK/WEBSITE/...);
  // `provider` distinguishes the specific ingestion mechanism within that
  // bucket where more than one exists (e.g. FACEBOOK source via a page
  // message vs. via a Lead Ads form). `createdAt` (above, already
  // immutable — @default(now()), no updatedAt-style touch) IS this lead's
  // first-touch timestamp; no separate timestamp field is added to avoid
  // two sources of truth for the same fact.
  provider              String?  // e.g. META_LEAD_ADS, META_MESSAGE, SCOREAPP, WEBSITE_FORM, WEBSITE_CHAT, QR, MANUAL
  campaignId            String?  // ad platform's campaign id, where available
  campaignName          String?
  adId                  String?
  adsetId               String?
  formId                String?  // Meta leadgen form id / ScoreApp quiz id / website form id
  landingPageUrl        String?
  externalSubmissionId  String?  // durable id from the source system (Meta leadgen_id, ScoreApp submission id, etc.) — idempotency key
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm               String?

  nurtureLogs         NurtureLog[]
  stageHistory        LeadStageHistory[]
  slaEvents           LeadSlaEvent[]
  sequenceEnrollments SequenceEnrollment[]
  consentLogs         LeadConsentLog[]

  @@unique([source, externalSubmissionId])
  @@index([source])
  @@index([status])
  @@index([assignedTo])
  @@index([firstReplyAt])
  @@index([createdAt])
  @@index([campaignId])
  @@map("leads")
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  description String?
  questions   String   // JSON string
  resultText  String   // JSON string
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("quizzes")
}

model QRCapture {
  id         String   @id @default(uuid())
  name       String
  formConfig String   // JSON string
  destination String  @default("CRM")
  qrCodeData String?
  scanCount  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("qr_captures")
}

model WebsiteVisitor {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  page          String?
  ip            String?
  userAgent     String?
  capturedEmail String?
  capturedName  String?
  agentEngaged  Boolean  @default(false)
  agentLogId    String?
  createdAt     DateTime @default(now())

  @@map("website_visitors")
}

model Campaign {
  id              String   @id @default(uuid())
  type            String
  name            String
  channel         String   @default("WHATSAPP")
  messageTemplate String
  targetSegment   String?  // JSON string
  scheduledAt     DateTime?
  status          String   @default("DRAFT")
  sentCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nurtureLogs NurtureLog[]

  @@map("campaigns")
}

model NurtureLog {
  id          String   @id @default(uuid())
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  channel     String
  message     String
  status      String   @default("QUEUED")
  sentAt      DateTime?
  deliveredAt DateTime?
  externalId  String?
  createdAt   DateTime @default(now())

  @@map("nurture_logs")
}

model AgentLog {
  id          String   @id @default(uuid())
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])
  visitorId   String?
  callSid     String?
  type        String
  channel     String   @default("VOICE")
  transcript  String?
  outcome     String?
  durationSec Int?
  escalated   Boolean  @default(false)
  createdAt   DateTime @default(now())

  recording   CallRecording?

  @@map("agent_logs")
}

model CallRecording {
  id             String   @id @default(uuid())
  agentLogId     String   @unique
  agentLog       AgentLog @relation(fields: [agentLogId], references: [id])
  r2Key          String
  durationSec    Int?
  transcriptText String?
  qualityScore   Float?
  adminNotes     String?
  createdAt      DateTime @default(now())

  @@map("call_recordings")
}

model AgentPrompt {
  id           String   @id @default(uuid())
  type         String   @unique
  name         String
  systemPrompt String
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("agent_prompts")
}

model VoiceProfile {
  id                String   @id @default(uuid())
  name              String
  elevenLabsVoiceId String
  isCloned          Boolean  @default(false)
  previewR2Key      String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@map("voice_profiles")
}

model KnowledgeBase {
  id         String   @id @default(uuid())
  title      String
  type       String
  r2Key      String?
  sourceUrl  String?
  rawText    String?
  chunkIndex Int      @default(0)
  parentId   String?
  isActive   Boolean  @default(true)
  embedding  String?  // JSON array of floats (OpenAI text-embedding-ada-002)
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("knowledge_base")
}

model PatientFeedback {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  channel       String   @default("APP")
  submittedAt   DateTime @default(now())

  @@map("patient_feedback")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String   // HTTP method or semantic action (kept for compat)
  resource     String
  resourceId   String?
  metadata     String?  // JSON string
  ip           String?
  userAgent    String?
  // v2 compliance fields
  entityType   String?  // PATIENT | APPOINTMENT | INVOICE | SERVICE | STAFF | TREATMENT_PLAN | NOTE | PAYMENT
  entityId     String?
  entityName   String?
  actionType   String?  // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | VIEW_SENSITIVE | EXPORT | RESCHEDULE | CANCEL | CONFIRM | PAYMENT_RECEIVED | STATUS_CHANGE
  fieldChanges String?  // JSON: { before: Record<string,any>, after: Record<string,any> }
  hashChain    String?  // SHA-256 of prevHash + entryData for tamper detection
  severity     String   @default("INFO") // INFO | WARNING | CRITICAL
  notes        String?
  createdAt    DateTime @default(now())

  @@index([entityType, createdAt])
  @@index([entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model AssistantMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   // USER | ASSISTANT
  content   String
  context   String?  // JSON string
  createdAt DateTime @default(now())

  @@map("assistant_messages")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  title       String
